{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oshe.example/schemas/api/error-envelope.schema.json",
  "title": "OSHE Provisional API Error Envelope",
  "description": "Provisional static error response schema for v0.2.0 API contract slice pending H020-005.",
  "type": "object",
  "required": [
    "code",
    "message",
    "correlation_id",
    "details"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
