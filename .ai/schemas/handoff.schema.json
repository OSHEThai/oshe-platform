{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Handoff",
  "type": "object",
  "required": [
    "contract_type",
    "contract_version",
    "mission_id",
    "summary",
    "scope_completed",
    "scope_not_completed",
    "human_decisions",
    "risks",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "contract_type": { "const": "handoff" },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "const": "1.0.0"
    },
    "mission_id": { "$ref": "#/$defs/non_empty_string" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "scope_completed": { "$ref": "#/$defs/string_array" },
    "scope_not_completed": { "$ref": "#/$defs/string_array" },
    "human_decisions": { "$ref": "#/$defs/string_array" },
    "risks": { "$ref": "#/$defs/string_array" },
    "evidence": { "$ref": "#/$defs/string_array" },
    "recommendation": { "$ref": "#/$defs/non_empty_string" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
