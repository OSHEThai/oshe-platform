{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oshe.local/schemas/evidence-record.schema.json",
  "title": "OSHE Evidence Record",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_class",
    "claim",
    "repository",
    "commit",
    "environment",
    "command_or_method",
    "result",
    "artifact_refs",
    "captured_at",
    "captured_by",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
    "evidence_class": {
      "enum": ["STATIC", "CONTRACT", "SYNTHETIC", "CI", "RUNTIME", "HUMAN", "CLEAN_MACHINE", "INDEPENDENT_REVIEW", "RELEASE"]
    },
    "claim": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": ["string", "null"]},
    "environment": {"type": "string", "minLength": 1},
    "command_or_method": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "SKIPPED", "UNKNOWN", "INCONCLUSIVE", "QUARANTINED"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "captured_at": {"type": "string", "format": "date-time"},
    "captured_by": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "review_ref": {"type": ["string", "null"]},
    "human_decision_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
