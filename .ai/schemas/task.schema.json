{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task",
  "type": "object",
  "required": [
    "id",
    "mission_id",
    "role",
    "mode",
    "depends_on",
    "allowed_paths",
    "acceptance_criteria",
    "required_checks",
    "output_schema"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "READ_ONLY",
        "WRITE",
        "TEST_ONLY",
        "GITHUB_METADATA"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_schema": {
      "type": "string"
    },
    "tool_profile": {
      "type": "string"
    }
  },
  "additionalProperties": true
}