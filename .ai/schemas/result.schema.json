{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task Result",
  "type": "object",
  "required": [
    "contract_type",
    "contract_version",
    "task_id",
    "status",
    "material_write",
    "agent",
    "git",
    "changes",
    "commands_run",
    "tests",
    "assumptions",
    "risks",
    "decisions_needed"
  ],
  "properties": {
    "contract_type": { "const": "result" },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "const": "1.0.0"
    },
    "task_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "enum": ["SUBMITTED", "BLOCKED", "FAILED"] },
    "material_write": { "type": "boolean" },
    "agent": { "$ref": "#/$defs/agent" },
    "git": { "$ref": "#/$defs/git" },
    "changes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "commands_run": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "tests": { "$ref": "#/$defs/tests" },
    "assumptions": { "$ref": "#/$defs/string_array" },
    "risks": { "$ref": "#/$defs/string_array" },
    "decisions_needed": { "$ref": "#/$defs/string_array" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "material_write": { "const": true } }, "required": ["material_write"] },
      "then": {
        "properties": {
          "git": { "required": ["result_commit"], "not": { "required": ["no_commit_reason"] } },
          "changes": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "git": { "required": ["no_commit_reason"], "not": { "required": ["result_commit"] } },
          "changes": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "material_write": { "const": false }, "status": { "const": "BLOCKED" } },
        "required": ["material_write", "status"]
      },
      "then": {
        "properties": { "git": { "properties": { "no_commit_reason": { "const": "BLOCKED_BEFORE_MATERIAL_WRITE" } } } }
      }
    },
    {
      "if": {
        "properties": { "material_write": { "const": false }, "status": { "const": "FAILED" } },
        "required": ["material_write", "status"]
      },
      "then": {
        "properties": { "git": { "properties": { "no_commit_reason": { "const": "FAILED_BEFORE_MATERIAL_WRITE" } } } }
      }
    },
    {
      "if": {
        "properties": { "material_write": { "const": false }, "status": { "const": "SUBMITTED" } },
        "required": ["material_write", "status"]
      },
      "then": {
        "properties": {
          "git": {
            "properties": {
              "no_commit_reason": {
                "enum": ["READ_ONLY_TASK", "TEST_ONLY_NO_MATERIAL_WRITE", "NO_CHANGE_REQUIRED"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "tests": { "properties": { "overall": { "const": "PASS" } }, "required": ["overall"] } }
      },
      "then": {
        "properties": {
          "tests": {
            "properties": {
              "executions": {
                "minItems": 1,
                "items": {
                  "properties": { "outcome": { "const": "PASS" }, "exit_code": { "type": "integer" } },
                  "required": ["exit_code"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "tests": { "properties": { "overall": { "const": "NOT_RUN" } }, "required": ["overall"] } }
      },
      "then": { "properties": { "tests": { "properties": { "executions": { "maxItems": 0 } } } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "full_commit": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64}|1{40}|1{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "agent": {
      "type": "object",
      "required": ["provider", "model", "role_version", "skills"],
      "properties": {
        "provider": { "$ref": "#/$defs/non_empty_string" },
        "model": { "$ref": "#/$defs/non_empty_string" },
        "role_version": { "$ref": "#/$defs/non_empty_string" },
        "skills": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": ["base_commit", "branch"],
      "properties": {
        "base_commit": { "$ref": "#/$defs/full_commit" },
        "branch": { "$ref": "#/$defs/non_empty_string" },
        "result_commit": { "$ref": "#/$defs/full_commit" },
        "no_commit_reason": {
          "enum": [
            "READ_ONLY_TASK",
            "BLOCKED_BEFORE_MATERIAL_WRITE",
            "FAILED_BEFORE_MATERIAL_WRITE",
            "TEST_ONLY_NO_MATERIAL_WRITE",
            "NO_CHANGE_REQUIRED"
          ]
        }
      },
      "additionalProperties": false
    },
    "test_execution": {
      "type": "object",
      "required": ["id", "command", "outcome", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "outcome": { "enum": ["PASS", "FAIL", "SKIPPED", "INCONCLUSIVE"] },
        "exit_code": { "type": ["integer", "null"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": ["overall", "executions"],
      "properties": {
        "overall": { "enum": ["PASS", "FAIL", "NOT_RUN", "INCONCLUSIVE"] },
        "executions": { "type": "array", "items": { "$ref": "#/$defs/test_execution" } }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
