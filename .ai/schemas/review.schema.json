{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Review",
  "type": "object",
  "required": [
    "task_id",
    "verdict",
    "reviewer",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUIRED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "reviewer": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "issue",
          "required_fix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue": {
            "type": "string"
          },
          "required_fix": {
            "type": "string"
          },
          "required_test": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}