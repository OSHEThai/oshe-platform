  "$id": "https://oshe.example/schemas/provider-routing.schema.json",
  "title": "OSHE Canonical Role-to-Provider Routing Policy",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "default_policy",
    "routing_status",
    "role_routes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "registry_id": {
      "const": "REG-ROUTING-001"
    },
    "default_policy": {
      "const": "DENY_IF_NO_APPROVED_ROUTE"
    },
