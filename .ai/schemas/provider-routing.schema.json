          "type": "object",
          "required": [
            "primary_route_id",
            "fallback_route_ids",
            "selection_state",
            "dispatch_enabled"
          ],
          "properties": {
            "primary_route_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_route_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selection_state": {
              "enum": [
                "UNASSIGNED",
                "ASSIGNED_PENDING_QUALIFICATION",
                "ACTIVE",
                "SUSPENDED"
              ]
            },
            "dispatch_enabled": {
              "type": "boolean"
            }
