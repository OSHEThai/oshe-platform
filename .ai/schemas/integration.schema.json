{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integration Result",
  "type": "object",
  "required": [
    "contract_type",
    "contract_version",
    "mission_id",
    "integration_branch",
    "base_commit",
    "included_commits",
    "checks",
    "open_findings",
    "ready_for_human"
  ],
  "properties": {
    "contract_type": { "const": "integration" },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "const": "1.0.0"
    },
    "mission_id": { "$ref": "#/$defs/non_empty_string" },
    "integration_branch": { "$ref": "#/$defs/non_empty_string" },
    "base_commit": { "$ref": "#/$defs/full_commit" },
    "included_commits": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/full_commit" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/check" }
    },
    "open_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "ready_for_human": { "type": "boolean" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "ready_for_human": { "const": true } }, "required": ["ready_for_human"] },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": { "outcome": { "const": "PASS" }, "exit_code": { "type": "integer" } }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "full_commit": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64}|1{40}|1{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "check": {
      "type": "object",
      "required": ["id", "command", "outcome", "exit_code", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "outcome": { "enum": ["PASS", "FAIL", "SKIPPED", "INCONCLUSIVE"] },
        "exit_code": { "type": ["integer", "null"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
