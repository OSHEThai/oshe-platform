{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSHE Context Digest",
  "description": "Standalone governed context-digest contract (V010-I013 semantic 1B). Closed carrier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest_type",
    "algorithm",
    "canonicalization",
    "repository_commit",
    "inputs",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "digest_type": {
      "type": "string",
      "const": "oshe-context-digest"
    },
    "algorithm": {
      "type": "string",
      "const": "sha256"
    },
    "canonicalization": {
      "type": "string",
      "const": "OSHE-CONTEXT-v1"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
